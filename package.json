{
  "name": "shoficina",
  "version": "1.0.0",
  "description": "Sistema de gestão para loja de celulares e assistência técnica",
  "author": "CellFicina",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:frontend": "vite",
    "dev:backend": "tsx watch src/backend/server.ts",
    "dev:electron": "wait-on tcp:3456 tcp:5173 && cross-env NODE_ENV=development electron . --no-sandbox --disable-setuid-sandbox",
    "build": "npm run prisma:generate && npm run build:frontend && npm run build:backend && npm run build:electron",
    "build:frontend": "vite build",
    "build:backend": "esbuild src/backend/server.ts --bundle --platform=node --target=node20 --outfile=dist/backend/server.js --external:electron --external:@prisma/client --external:.prisma/client --sourcemap",
    "build:electron": "esbuild src/electron/main.ts src/electron/preload.ts --bundle --platform=node --target=node20 --outdir=dist-electron --external:electron --external:@prisma/client --sourcemap",
    "prepare:pack": "node scripts/prepare-pack.js",
    "dist": "node scripts/dist.js all",
    "dist:win": "node scripts/dist.js win",
    "dist:linux": "node scripts/dist.js linux",
    "dist:dir": "node scripts/prepare-pack.js && npm run build && electron-builder --dir --publish never",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate --schema database/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema database/prisma/schema.prisma",
    "prisma:seed": "tsx database/prisma/seed.ts",
    "postinstall": "prisma generate --schema database/prisma/schema.prisma"
  },
  "prisma": {
    "schema": "database/prisma/schema.prisma",
    "seed": "tsx database/prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.16.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.1",
    "cors": "^2.8.5",
    "cross-env": "^10.0.0",
    "decimal.js": "^10.5.0",
    "electron": "^37.4.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.9",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.544.0",
    "prisma": "6.16.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.6",
    "vitest": "^3.2.4",
    "wait-on": "^8.0.5",
    "zod": "^3.25.76"
  },
  "build": {
    "appId": "com.shoficina.app",
    "productName": "CellFicina",
    "copyright": "Copyright © CellFicina",
    "asar": true,
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "electronLanguages": ["pt-BR", "en-US"],
    "beforePack": "scripts/before-pack.js",
    "afterPack": "scripts/after-pack.js",
    "afterAllArtifactBuild": "scripts/after-all-artifact-build.js",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist-electron/**/*",
      "!dist-electron/**/*.map",
      "dist/renderer/**/*",
      "package.json",
      {
        "from": "node_modules/@prisma/client",
        "to": "node_modules/@prisma/client",
        "filter": [
          "package.json",
          "default.js",
          "index.js",
          "runtime/library.js"
        ]
      }
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "extraResources": [
      {
        "from": "database/prisma",
        "to": "prisma",
        "filter": ["schema.prisma", "migrations/**/*"]
      },
      {
        "from": "build/pack/prisma-client",
        "to": "prisma-client"
      }
    ],
    "win": {
      "executableName": "CellFicina",
      "icon": "build/icon.ico",
      "artifactName": "${productName}-${version}-Windows.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CellFicina",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "linux": {
      "executableName": "CellFicina",
      "icon": "build/icon.png",
      "executableArgs": [],
      "target": ["AppImage", "tar.gz"],
      "category": "Office",
      "synopsis": "Gestão para loja de celulares e assistência técnica",
      "artifactName": "${productName}-${version}-Linux.${ext}"
    }
  }
}
